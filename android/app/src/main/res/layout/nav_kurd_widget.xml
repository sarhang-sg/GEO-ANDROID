<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false">

    <ImageView
        android:id="@+id/widget_scene"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/widget_description"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="13dp"
        android:paddingTop="10dp"
        android:paddingEnd="13dp"
        android:paddingBottom="9dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:layoutDirection="rtl"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_weather_icon"
                android:layout_width="56dp"
                android:layout_height="54dp"
                android:contentDescription="@string/widget_description"
                android:scaleType="fitCenter" />

            <ImageView
                        android:id="@+id/widget_temperature"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter"
                        android:contentDescription="@string/widget_description" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_weight="1"
                android:gravity="end"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical|end"
                    android:layoutDirection="rtl"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/widget_city"
                        android:layout_width="0dp"
                        android:layout_height="24dp"
                        android:layout_weight="1"
                        android:adjustViewBounds="true"
                        android:scaleType="fitEnd"
                        android:contentDescription="@string/widget_description" />

                    <TextClock
                        android:id="@+id/widget_local_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="7dp"
                        android:fontFamily="@font/uniqaidar_money_heist_002"
                        android:format12Hour="h:mm a"
                        android:format24Hour="HH:mm"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="#FFD9ECFF"
                        android:textDirection="ltr"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ImageView
                        android:id="@+id/widget_condition"
                    android:layout_width="match_parent"
                    android:layout_height="21dp"
                    android:layout_marginTop="2dp"
                        android:adjustViewBounds="true"
                        android:scaleType="fitEnd"
                        android:contentDescription="@string/widget_description" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="end|center_vertical"
                    android:layoutDirection="rtl"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/widget_season"
                        android:layout_width="wrap_content"
                        android:layout_height="17dp"
                        android:layout_marginStart="0dp"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter"
                        android:contentDescription="@string/widget_description" />

                    <ImageView
                        android:id="@+id/widget_phase"
                        android:layout_width="wrap_content"
                        android:layout_height="17dp"
                        android:layout_marginStart="8dp"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter"
                        android:contentDescription="@string/widget_description" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:layoutDirection="rtl"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:background="@drawable/widget_metric_chip"
                android:gravity="center"
                android:orientation="horizontal">
                <ImageView android:layout_width="13dp" android:layout_height="13dp" android:contentDescription="@string/widget_description" android:src="@drawable/ic_widget_humidity" />
                <ImageView
                        android:id="@+id/widget_humidity" android:layout_width="wrap_content" android:layout_height="19dp" android:layout_marginStart="3dp"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter"
                        android:contentDescription="@string/widget_description" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="@drawable/widget_metric_chip"
                android:gravity="center"
                android:orientation="horizontal">
                <ImageView android:layout_width="13dp" android:layout_height="13dp" android:contentDescription="@string/widget_description" android:src="@drawable/ic_widget_wind" />
                <ImageView
                        android:id="@+id/widget_wind" android:layout_width="wrap_content" android:layout_height="19dp" android:layout_marginStart="3dp"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter"
                        android:contentDescription="@string/widget_description" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_dust_group"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="@drawable/widget_metric_chip"
                android:gravity="center"
                android:orientation="horizontal">
                <ImageView android:id="@+id/widget_dust_icon" android:layout_width="13dp" android:layout_height="13dp" android:contentDescription="@string/widget_description" android:src="@drawable/ic_widget_dust" />
                <ImageView
                        android:id="@+id/widget_dust" android:layout_width="wrap_content" android:layout_height="19dp" android:layout_marginStart="3dp"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter"
                        android:contentDescription="@string/widget_description" />
            </LinearLayout>

            <ImageView
                android:id="@+id/widget_refresh"
                android:layout_width="32dp"
                android:layout_height="30dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/widget_button_secondary"
                android:contentDescription="@string/widget_refresh"
                android:padding="8dp"
                android:src="@drawable/ic_widget_refresh" />

            <ImageView
                android:id="@+id/widget_locate"
                android:layout_width="32dp"
                android:layout_height="30dp"
                android:layout_marginStart="5dp"
                android:background="@drawable/widget_button"
                android:contentDescription="@string/widget_locate"
                android:padding="8dp"
                android:src="@drawable/ic_widget_locate" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:layoutDirection="rtl"
            android:orientation="horizontal">

            <ImageView
                        android:id="@+id/widget_status"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:background="@drawable/widget_status_chip"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter"
                        android:contentDescription="@string/widget_description" />

            <ImageView
                        android:id="@+id/widget_detail"
                android:layout_width="0dp"
                android:layout_height="18dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                        android:adjustViewBounds="true"
                        android:scaleType="fitEnd"
                        android:contentDescription="@string/widget_description" />
        </LinearLayout>

            <ImageView
                        android:id="@+id/widget_updated"
                android:layout_width="wrap_content"
                android:layout_height="13dp"
                android:layout_marginStart="6dp"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter"
                        android:contentDescription="@string/widget_description" />
    </LinearLayout>
</FrameLayout>
