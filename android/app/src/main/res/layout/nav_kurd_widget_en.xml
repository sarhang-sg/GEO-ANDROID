<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false">
    <ImageView android:id="@+id/widget_scene" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@string/widget_description" android:scaleType="centerCrop" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical" android:paddingStart="15dp" android:paddingTop="11dp" android:paddingEnd="15dp" android:paddingBottom="10dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:layoutDirection="ltr" android:orientation="horizontal">
            <ImageView android:id="@+id/widget_weather_icon" android:layout_width="72dp" android:layout_height="64dp" android:contentDescription="@string/widget_description" android:scaleType="fitCenter" />
            <TextView android:id="@+id/widget_temperature" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="9dp" android:fontFamily="@font/nav_kurd_latin" android:includeFontPadding="false" android:text="—°" android:textColor="#FFFFFFFF" android:textSize="31sp" android:textStyle="bold" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="11dp" android:layout_weight="1" android:gravity="start" android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical|start" android:orientation="horizontal">
                    <TextView android:id="@+id/widget_city" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:fontFamily="@font/nav_kurd_latin" android:gravity="start" android:includeFontPadding="false" android:maxLines="1" android:text="Unknown location" android:textColor="#FFFFFFFF" android:textSize="15sp" android:textStyle="bold" />
                    <TextClock android:id="@+id/widget_local_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:fontFamily="@font/nav_kurd_latin" android:format12Hour="h:mm a" android:format24Hour="HH:mm" android:includeFontPadding="false" android:maxLines="1" android:textColor="#FFF1D999" android:textSize="10sp" android:textStyle="bold" />
                </LinearLayout>
                <TextView android:id="@+id/widget_condition" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:ellipsize="end" android:fontFamily="@font/nav_kurd_latin" android:gravity="start" android:includeFontPadding="false" android:maxLines="1" android:text="Weather unavailable" android:textColor="#FFDDF8FF" android:textSize="11sp" android:textStyle="bold" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="start|center_vertical" android:orientation="horizontal">
                    <ImageView android:id="@+id/widget_season_icon" android:layout_width="15dp" android:layout_height="15dp" android:contentDescription="@string/widget_description" android:scaleType="fitCenter" />
                    <TextView android:id="@+id/widget_season" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:fontFamily="@font/nav_kurd_latin" android:includeFontPadding="false" android:maxLines="1" android:textColor="#FFB7F1FF" android:textSize="9sp" android:textStyle="bold" />
                    <TextView android:id="@+id/widget_phase" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:fontFamily="@font/nav_kurd_latin" android:includeFontPadding="false" android:maxLines="1" android:textColor="#FFF1D999" android:textSize="9sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center_vertical" android:layoutDirection="ltr" android:orientation="horizontal">
            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:contentDescription="@string/widget_description" android:src="@drawable/ic_widget_humidity" />
            <TextView android:id="@+id/widget_humidity" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="3dp" android:fontFamily="@font/nav_kurd_latin" android:includeFontPadding="false" android:text="—%" android:textColor="#FFFFFFFF" android:textSize="9sp" android:textStyle="bold" />
            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_marginStart="12dp" android:contentDescription="@string/widget_description" android:src="@drawable/ic_widget_wind" />
            <TextView android:id="@+id/widget_wind" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="3dp" android:fontFamily="@font/nav_kurd_latin" android:includeFontPadding="false" android:text="— km/h" android:textColor="#FFFFFFFF" android:textSize="9sp" android:textStyle="bold" />
            <ImageView android:id="@+id/widget_dust_icon" android:layout_width="16dp" android:layout_height="16dp" android:layout_marginStart="12dp" android:contentDescription="@string/widget_description" android:src="@drawable/ic_widget_dust" />
            <TextView android:id="@+id/widget_dust" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="3dp" android:layout_weight="1" android:ellipsize="end" android:fontFamily="@font/nav_kurd_latin" android:includeFontPadding="false" android:maxLines="1" android:textColor="#FFFFFFFF" android:textSize="9sp" android:textStyle="bold" />
            <ImageView android:id="@+id/widget_refresh" android:layout_width="35dp" android:layout_height="31dp" android:background="@drawable/widget_button_secondary" android:contentDescription="@string/widget_refresh" android:padding="8dp" android:src="@drawable/ic_widget_refresh" />
            <ImageView android:id="@+id/widget_locate" android:layout_width="35dp" android:layout_height="31dp" android:layout_marginStart="6dp" android:background="@drawable/widget_button" android:contentDescription="@string/widget_locate" android:padding="8dp" android:src="@drawable/ic_widget_locate" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:gravity="center_vertical" android:layoutDirection="ltr" android:orientation="horizontal">
            <TextView android:id="@+id/widget_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/widget_status_chip" android:fontFamily="@font/nav_kurd_latin" android:includeFontPadding="false" android:maxLines="1" android:text="NAV KURD" android:textColor="#FFCCF7FF" android:textSize="8sp" android:textStyle="bold" />
            <TextView android:id="@+id/widget_detail" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="7dp" android:layout_weight="1" android:ellipsize="end" android:fontFamily="@font/nav_kurd_latin" android:gravity="start" android:includeFontPadding="false" android:maxLines="1" android:text="Kurdistan map" android:textColor="#FFC8CFDE" android:textSize="8sp" />
            <TextView android:id="@+id/widget_updated" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="7dp" android:fontFamily="@font/nav_kurd_latin" android:includeFontPadding="false" android:maxLines="1" android:text="Open-Meteo" android:textColor="#FFA9B3C8" android:textSize="7sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
