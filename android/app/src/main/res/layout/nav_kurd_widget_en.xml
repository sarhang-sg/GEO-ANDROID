<?xml version="1.0" encoding="utf-8"?>
<!-- Compact seasonal card. Launcher allocation must not stretch the content. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
  <FrameLayout android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="196dp" android:layout_gravity="center" android:background="@drawable/widget_background" android:clipToOutline="true">
    <ImageView android:id="@+id/widget_scene" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="fitXY" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="6dp" android:paddingBottom="4dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="22dp" android:layoutDirection="ltr" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:id="@+id/widget_city" android:layout_width="0dp" android:layout_height="20dp" android:adjustViewBounds="true" android:scaleType="fitStart" android:contentDescription="@string/widget_description" android:layout_weight="1"/>
            <TextClock android:id="@+id/widget_local_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:fontFamily="@font/red_hat_display_variable" android:format12Hour="h:mm a" android:format24Hour="HH:mm" android:includeFontPadding="false" android:maxLines="1" android:textStyle="bold" android:textColor="#F1F6FF" android:textDirection="ltr" android:textSize="14sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical" android:layoutDirection="ltr" android:orientation="horizontal">
            <ImageView android:id="@+id/widget_weather_icon" android:layout_width="42dp" android:layout_height="42dp" android:contentDescription="@string/widget_description" android:scaleType="fitCenter" />
            <ImageView android:id="@+id/widget_temperature" android:layout_width="64dp" android:layout_height="40dp" android:adjustViewBounds="true" android:scaleType="fitStart" android:contentDescription="@string/widget_description" android:layout_marginStart="4dp"/>
            <ImageView android:id="@+id/widget_condition" android:layout_width="0dp" android:layout_height="26dp" android:adjustViewBounds="true" android:scaleType="fitStart" android:contentDescription="@string/widget_description" android:layout_weight="1" android:layout_marginStart="6dp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="14dp" android:gravity="center_vertical" android:layoutDirection="ltr" android:orientation="horizontal">
            <ImageView android:id="@+id/widget_season" android:layout_width="60dp" android:layout_height="14dp" android:scaleType="fitCenter" android:contentDescription="@string/widget_description" />
            <ImageView android:id="@+id/widget_phase" android:layout_width="100dp" android:layout_height="14dp" android:scaleType="fitCenter" android:contentDescription="@string/widget_description" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="22dp" android:gravity="center_vertical" android:layoutDirection="ltr" android:orientation="horizontal">
            <LinearLayout  android:layout_width="0dp" android:layout_height="22dp" android:layout_weight="1" android:gravity="center" android:orientation="horizontal">
                <ImageView  android:layout_width="13dp" android:layout_height="13dp" android:importantForAccessibility="no" android:src="@drawable/ic_widget_humidity" />
                <ImageView android:id="@+id/widget_humidity" android:layout_width="wrap_content" android:layout_height="18dp" android:adjustViewBounds="true" android:scaleType="fitStart" android:contentDescription="@string/widget_description" android:layout_marginStart="4dp"/>
            </LinearLayout>
            <LinearLayout  android:layout_width="0dp" android:layout_height="22dp" android:layout_weight="1" android:gravity="center" android:orientation="horizontal">
                <ImageView  android:layout_width="13dp" android:layout_height="13dp" android:importantForAccessibility="no" android:src="@drawable/ic_widget_wind" />
                <ImageView android:id="@+id/widget_wind" android:layout_width="wrap_content" android:layout_height="18dp" android:adjustViewBounds="true" android:scaleType="fitStart" android:contentDescription="@string/widget_description" android:layout_marginStart="4dp"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/widget_dust_group" android:layout_width="0dp" android:layout_height="22dp" android:layout_weight="1" android:gravity="center" android:orientation="horizontal">
                <ImageView android:id="@+id/widget_dust_icon" android:layout_width="13dp" android:layout_height="13dp" android:importantForAccessibility="no" android:src="@drawable/ic_widget_dust" />
                <ImageView android:id="@+id/widget_dust" android:layout_width="wrap_content" android:layout_height="18dp" android:adjustViewBounds="true" android:scaleType="fitStart" android:contentDescription="@string/widget_description" android:layout_marginStart="4dp"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_forecast_row" android:layout_width="match_parent" android:layout_height="36dp" android:layout_marginTop="2dp" android:orientation="horizontal" android:layoutDirection="ltr" android:visibility="gone">
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <ImageView android:id="@+id/widget_hour_0" android:layout_width="match_parent" android:layout_height="14dp" android:scaleType="fitCenter" android:contentDescription="@string/widget_description" />
                <ImageView android:id="@+id/widget_forecast_0" android:layout_width="match_parent" android:layout_height="20dp" android:scaleType="fitCenter" android:contentDescription="@string/widget_description" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <ImageView android:id="@+id/widget_hour_1" android:layout_width="match_parent" android:layout_height="14dp" android:scaleType="fitCenter" android:contentDescription="@string/widget_description" />
                <ImageView android:id="@+id/widget_forecast_1" android:layout_width="match_parent" android:layout_height="20dp" android:scaleType="fitCenter" android:contentDescription="@string/widget_description" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <ImageView android:id="@+id/widget_hour_2" android:layout_width="match_parent" android:layout_height="14dp" android:scaleType="fitCenter" android:contentDescription="@string/widget_description" />
                <ImageView android:id="@+id/widget_forecast_2" android:layout_width="match_parent" android:layout_height="20dp" android:scaleType="fitCenter" android:contentDescription="@string/widget_description" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <ImageView android:id="@+id/widget_hour_3" android:layout_width="match_parent" android:layout_height="14dp" android:scaleType="fitCenter" android:contentDescription="@string/widget_description" />
                <ImageView android:id="@+id/widget_forecast_3" android:layout_width="match_parent" android:layout_height="20dp" android:scaleType="fitCenter" android:contentDescription="@string/widget_description" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <ImageView android:id="@+id/widget_hour_4" android:layout_width="match_parent" android:layout_height="14dp" android:scaleType="fitCenter" android:contentDescription="@string/widget_description" />
                <ImageView android:id="@+id/widget_forecast_4" android:layout_width="match_parent" android:layout_height="20dp" android:scaleType="fitCenter" android:contentDescription="@string/widget_description" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical" android:layoutDirection="ltr" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <ImageView android:id="@+id/widget_detail" android:layout_width="match_parent" android:layout_height="16dp" android:adjustViewBounds="true" android:scaleType="fitStart" android:contentDescription="@string/widget_description" android:visibility="gone"/>
                <ImageView android:id="@+id/widget_updated" android:layout_width="match_parent" android:layout_height="16dp" android:adjustViewBounds="true" android:scaleType="fitStart" android:contentDescription="@string/widget_description" />
            </LinearLayout>
            <ImageView android:id="@+id/widget_refresh" android:layout_width="44dp" android:layout_height="44dp" android:padding="13dp" android:contentDescription="@string/widget_refresh" android:src="@drawable/ic_widget_refresh" />
            <ImageView android:id="@+id/widget_locate" android:layout_width="44dp" android:layout_height="44dp" android:padding="13dp" android:contentDescription="@string/widget_locate" android:src="@drawable/ic_widget_locate" />
        </LinearLayout>
    </LinearLayout>
  </FrameLayout>
</FrameLayout>
