<?xml version="1.0" encoding="utf-8"?>
<!-- One surface, unboxed readings, restrained type and full-size action targets. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/widget_scene" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="fitXY" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="10dp" android:paddingBottom="6dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="27dp" android:layoutDirection="ltr" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:id="@+id/widget_city" android:layout_width="0dp" android:layout_height="24dp" android:adjustViewBounds="true" android:scaleType="fitStart" android:contentDescription="@string/widget_description" android:layout_weight="1"/>
            <TextClock android:id="@+id/widget_local_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:fontFamily="@font/red_hat_display_variable" android:format12Hour="h:mm a" android:format24Hour="HH:mm" android:includeFontPadding="false" android:maxLines="1" android:textColor="#B8C9DE" android:textDirection="ltr" android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="54dp" android:gravity="center_vertical" android:layoutDirection="ltr" android:orientation="horizontal">
            <ImageView android:id="@+id/widget_weather_icon" android:layout_width="54dp" android:layout_height="54dp" android:contentDescription="@string/widget_description" android:scaleType="fitCenter" />
            <ImageView android:id="@+id/widget_temperature" android:layout_width="78dp" android:layout_height="52dp" android:adjustViewBounds="true" android:scaleType="fitStart" android:contentDescription="@string/widget_description" android:layout_marginStart="4dp"/>
            <ImageView android:id="@+id/widget_condition" android:layout_width="0dp" android:layout_height="26dp" android:adjustViewBounds="true" android:scaleType="fitStart" android:contentDescription="@string/widget_description" android:layout_weight="1" android:layout_marginStart="6dp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="26dp" android:gravity="center_vertical" android:layoutDirection="ltr" android:orientation="horizontal">
            <LinearLayout  android:layout_width="0dp" android:layout_height="26dp" android:layout_weight="1" android:gravity="center" android:orientation="horizontal">
                <ImageView  android:layout_width="13dp" android:layout_height="13dp" android:importantForAccessibility="no" android:src="@drawable/ic_widget_humidity" />
                <ImageView android:id="@+id/widget_humidity" android:layout_width="wrap_content" android:layout_height="18dp" android:adjustViewBounds="true" android:scaleType="fitStart" android:contentDescription="@string/widget_description" android:layout_marginStart="4dp"/>
            </LinearLayout>
            <LinearLayout  android:layout_width="0dp" android:layout_height="26dp" android:layout_weight="1" android:gravity="center" android:orientation="horizontal">
                <ImageView  android:layout_width="13dp" android:layout_height="13dp" android:importantForAccessibility="no" android:src="@drawable/ic_widget_wind" />
                <ImageView android:id="@+id/widget_wind" android:layout_width="wrap_content" android:layout_height="18dp" android:adjustViewBounds="true" android:scaleType="fitStart" android:contentDescription="@string/widget_description" android:layout_marginStart="4dp"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/widget_dust_group" android:layout_width="0dp" android:layout_height="26dp" android:layout_weight="1" android:gravity="center" android:orientation="horizontal">
                <ImageView android:id="@+id/widget_dust_icon" android:layout_width="13dp" android:layout_height="13dp" android:importantForAccessibility="no" android:src="@drawable/ic_widget_dust" />
                <ImageView android:id="@+id/widget_dust" android:layout_width="wrap_content" android:layout_height="18dp" android:adjustViewBounds="true" android:scaleType="fitStart" android:contentDescription="@string/widget_description" android:layout_marginStart="4dp"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_forecast_row" android:layout_width="match_parent" android:layout_height="43dp" android:layout_marginTop="5dp" android:orientation="horizontal" android:layoutDirection="ltr" android:visibility="gone">
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <ImageView android:id="@+id/widget_hour_0" android:layout_width="match_parent" android:layout_height="17dp" android:scaleType="fitCenter" android:contentDescription="@string/widget_description" />
                <ImageView android:id="@+id/widget_forecast_0" android:layout_width="match_parent" android:layout_height="23dp" android:scaleType="fitCenter" android:contentDescription="@string/widget_description" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <ImageView android:id="@+id/widget_hour_1" android:layout_width="match_parent" android:layout_height="17dp" android:scaleType="fitCenter" android:contentDescription="@string/widget_description" />
                <ImageView android:id="@+id/widget_forecast_1" android:layout_width="match_parent" android:layout_height="23dp" android:scaleType="fitCenter" android:contentDescription="@string/widget_description" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <ImageView android:id="@+id/widget_hour_2" android:layout_width="match_parent" android:layout_height="17dp" android:scaleType="fitCenter" android:contentDescription="@string/widget_description" />
                <ImageView android:id="@+id/widget_forecast_2" android:layout_width="match_parent" android:layout_height="23dp" android:scaleType="fitCenter" android:contentDescription="@string/widget_description" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <ImageView android:id="@+id/widget_hour_3" android:layout_width="match_parent" android:layout_height="17dp" android:scaleType="fitCenter" android:contentDescription="@string/widget_description" />
                <ImageView android:id="@+id/widget_forecast_3" android:layout_width="match_parent" android:layout_height="23dp" android:scaleType="fitCenter" android:contentDescription="@string/widget_description" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <ImageView android:id="@+id/widget_hour_4" android:layout_width="match_parent" android:layout_height="17dp" android:scaleType="fitCenter" android:contentDescription="@string/widget_description" />
                <ImageView android:id="@+id/widget_forecast_4" android:layout_width="match_parent" android:layout_height="23dp" android:scaleType="fitCenter" android:contentDescription="@string/widget_description" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical" android:layoutDirection="ltr" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <ImageView android:id="@+id/widget_detail" android:layout_width="match_parent" android:layout_height="16dp" android:adjustViewBounds="true" android:scaleType="fitStart" android:contentDescription="@string/widget_description" android:visibility="gone"/>
                <ImageView android:id="@+id/widget_updated" android:layout_width="match_parent" android:layout_height="16dp" android:adjustViewBounds="true" android:scaleType="fitStart" android:contentDescription="@string/widget_description" />
            </LinearLayout>
            <ImageView android:id="@+id/widget_refresh" android:layout_width="44dp" android:layout_height="44dp" android:padding="13dp" android:contentDescription="@string/widget_refresh" android:src="@drawable/ic_widget_refresh" />
            <ImageView android:id="@+id/widget_locate" android:layout_width="44dp" android:layout_height="44dp" android:padding="13dp" android:contentDescription="@string/widget_locate" android:src="@drawable/ic_widget_locate" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
