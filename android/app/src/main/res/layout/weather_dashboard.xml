<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/weather_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:layoutDirection="ltr" android:background="@drawable/widget_background" android:clipToOutline="true">
    <include layout="@layout/weather_surface" />
    <LinearLayout android:id="@+id/weather_actions" android:layout_width="88dp" android:layout_height="40dp"
        android:layout_gravity="bottom|left" android:orientation="horizontal" android:visibility="gone">
        <TextView android:id="@+id/weather_gps" android:layout_width="44dp" android:layout_height="match_parent"
            android:contentDescription="@string/weather_gps" android:focusable="true" />
        <TextView android:id="@+id/weather_refresh" android:layout_width="44dp" android:layout_height="match_parent"
            android:contentDescription="@string/weather_refresh" android:focusable="true" />
    </LinearLayout>
</FrameLayout>
