<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/weather_root" android:layout_width="match_parent" android:layout_height="match_parent" android:layoutDirection="ltr" android:background="@drawable/widget_night">
    <ImageView android:id="@+id/weather_bitmap" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:contentDescription="Open-Meteo · Developer: Sarhang Salah" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:weightSum="100">
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="24" android:orientation="horizontal">
            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="38" />
            <TextView android:id="@+id/weather_city" android:layout_width="0dp" android:layout_height="match_parent" android:contentDescription="شار هەڵبژێرە" android:focusable="true" android:layout_weight="62" android:text="@string/weather_pick_city" android:textColor="#FFFFFF" android:gravity="center" android:ellipsize="end" android:maxLines="1" android:textSize="16sp" android:textStyle="bold" android:shadowColor="#F5142137" android:shadowRadius="3" android:shadowDy="1" android:paddingStart="3dp" android:paddingEnd="3dp" />
        </LinearLayout>
        <TextView android:id="@+id/weather_forecast" android:layout_width="match_parent" android:layout_height="0dp" android:contentDescription="پێشبینیی ٢٤ کاتژمێر" android:focusable="true" android:layout_weight="42" android:text="@string/weather_open_forecast" android:textColor="#FFFFFF" android:gravity="center" android:ellipsize="end" android:maxLines="2" android:textSize="16sp" android:textStyle="bold" android:shadowColor="#F5142137" android:shadowRadius="3" android:shadowDy="1" android:paddingStart="3dp" android:paddingEnd="3dp" />
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="34" />
    </LinearLayout>
    <LinearLayout android:layout_width="72dp" android:layout_height="36dp" android:layout_gravity="bottom|left" android:orientation="horizontal">
        <TextView android:id="@+id/weather_gps" android:layout_width="36dp" android:layout_height="match_parent" android:contentDescription="شوێنی ئێستا" android:focusable="true" android:text="◎" android:textColor="#FFFFFF" android:gravity="center" android:ellipsize="end" android:maxLines="1" android:textSize="21sp" android:textStyle="bold" android:shadowColor="#F5142137" android:shadowRadius="3" android:shadowDy="1" android:paddingStart="3dp" android:paddingEnd="3dp" />
        <TextView android:id="@+id/weather_refresh" android:layout_width="36dp" android:layout_height="match_parent" android:contentDescription="نوێکردنەوە" android:focusable="true" android:text="↻" android:textColor="#FFFFFF" android:gravity="center" android:ellipsize="end" android:maxLines="1" android:textSize="21sp" android:textStyle="bold" android:shadowColor="#F5142137" android:shadowRadius="3" android:shadowDy="1" android:paddingStart="3dp" android:paddingEnd="3dp" />
    </LinearLayout>
</FrameLayout>
